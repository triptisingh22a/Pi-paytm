DEMO_MODE=cached
POSTGRES_PASSWORD=local-demo-only
# Optional; omit to use persistent SQLite for local development.
# DATABASE_URL=sqlite:///data/munshi.db
ASSUMED_BORROWING_COST=0.02
GAP_THRESHOLD=0.35
API_INTERNAL_URL=http://127.0.0.1:8000
# Partner adapters disabled unless verified. Empty values never break cached mode.
SARVAM_API_KEY=
SARVAM_MODEL=
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=
N8N_WEBHOOK_URL=
COGNEE_ENABLED=false
# Speech is separately opt-in; no automatic paid chat/TTS requests.
SARVAM_VOICE_ENABLED=false
SARVAM_STT_MODEL=saaras:v4
# Optional private path outside this repository; do not commit credentials.
SARVAM_API_KEY_FILE=
GEMINI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Speech honors HTTPS_PROXY/HTTP_PROXY and NO_PROXY, ignores unrelated ALL_PROXY.
# Optional override; an explicitly empty SARVAM_HTTP_PROXY forces direct access.
# SARVAM_HTTP_PROXY=http://your-approved-proxy:8080

# Merchant chat uses Sarvam only; enabled + server key required. No retries.
SARVAM_CHAT_ENABLED=true
SARVAM_CHAT_MODEL=sarvam-105b
