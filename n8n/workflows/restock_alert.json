        300,
        0
      ],
      "parameters": {
        "url": "http://api:8000/restock-alert/kirana",
        "method": "GET",
        "options": {
          "timeout": 10000
        }
      }
    },
    {
      "id": "propose",
      "name": "Low cover proposal",
